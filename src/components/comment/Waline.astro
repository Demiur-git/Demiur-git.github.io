---
import { commentConfig } from "@/config";
import "@/styles/pages/waline.css";
interface Props { path: string; }
const config = {
	...commentConfig.waline,
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: [2, 300],
	meta: ["nick", "mail"],
	requiredMeta: ["nick"],
	login: "disable",
	imageUploader: false,
	search: false,
	texRenderer: false,
	highlighter: false,
	pageview: Boolean(commentConfig.waline?.visitorCount),
	locale: { placeholder: "留下你的想法吧。留言审核后公开；昵称必填，邮箱选填且不会展示。" },
};
---
<waline-comments class="library-waline" data-config={JSON.stringify(config)}>
	<p class="waline-policy">留言审核后公开。昵称必填，邮箱选填且不会展示；本地试用暂不发送邮件通知。</p>
	<p data-waline-status role="status" aria-live="polite">正在连接留言服务…</p>
	<button type="button" data-waline-retry class="btn-regular" hidden>重新连接</button>
	<div data-waline-mount></div>
</waline-comments>
<script>
	import "@/utils/waline-comments";
</script>
