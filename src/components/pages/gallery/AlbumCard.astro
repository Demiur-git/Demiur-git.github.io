---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	previewPhotos: string[];
	index: number;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const {
	id,
	name,
	cover,
	previewPhotos,
	index,
	description,
	date,
	location,
	tags,
	photoCount,
	encrypted,
} = Astro.props;

const detailUrl = url(`/gallery/${id}/`);
const angles = [-4, 3, -2, 4, -3, 2];
const lifts = [4, 0, 8, 2, 7, 0];
const fallbackDescription = `${photoCount} ${i18n(I18nKey.galleryPhotos)}`;
---

<a
	href={detailUrl}
	class="album-card desk-album"
	data-tags={tags?.join(",") || ""}
	style={`--album-tilt: ${angles[index % angles.length]}deg; --album-lift: ${lifts[index % lifts.length]}px;`}
	aria-labelledby={`album-${id}-title`}
	aria-describedby={`album-${id}-desc`}
>
	<span class="album-art" aria-hidden="true">
		{!encrypted && previewPhotos[1] && (
			<span class="album-print album-print-back">
				<img src={previewPhotos[1]} alt="" loading="lazy" decoding="async" />
			</span>
		)}
		{!encrypted && previewPhotos[0] && (
			<span class="album-print album-print-front">
				<img src={previewPhotos[0]} alt="" loading="lazy" decoding="async" />
			</span>
		)}
		<span class="album-volume">
			<span class="album-volume-pages"></span>
			<span class="album-volume-face">
				{cover ? (
					<img src={cover} alt="" loading="lazy" decoding="async" />
				) : (
					<span class="album-cover-placeholder">
						<Icon name="material-symbols:photo-library" />
					</span>
				)}
				<span class="album-cover-shade"></span>
				<span class="album-cover-label">IMAGE FOLIO · {String(index + 1).padStart(2, "0")}</span>
				<span class="album-cover-title">{name}</span>
				{encrypted && (
					<span class="album-cover-lock"><Icon name="material-symbols:lock-outline-rounded" /></span>
				)}
			</span>
			<span class="album-volume-spine"></span>
		</span>
	</span>
	<span class="album-caption">
		<span class="album-catalogue">FOLIO · {String(index + 1).padStart(2, "0")}</span>
		<strong class="album-card-title" id={`album-${id}-title`}>{name}</strong>
		<span class="album-card-desc" id={`album-${id}-desc`} title={description || undefined}>
			{description || fallbackDescription}
		</span>
		<span class="album-caption-meta">
			{date && <time>{date}</time>}
			{location && <span class="album-card-location">{location}</span>}
			<span>{fallbackDescription}</span>
		</span>
		{encrypted && <span class="album-private-label">私藏影像册</span>}
		<span class="album-open-label">{i18n(I18nKey.galleryEnterAlbum)} <span aria-hidden="true">↗</span></span>
	</span>
</a>
