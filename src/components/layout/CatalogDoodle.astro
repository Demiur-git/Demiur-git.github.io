---
interface Props {
	code: string;
}

const kind = Astro.props.code.split("·", 1)[0].trim();
---

<svg
	viewBox="0 0 72 72"
	fill="none"
	stroke="currentColor"
	stroke-width="2.4"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{kind === "NOTE" && (
		<g>
			<path d="M14 13h34l8 8v36a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V16a3 3 0 0 1 3-3Z" />
			<path d="M48 13v9h8M20 27h23M20 34h18M20 41h13" />
			<path d="m37 54 17-17 5 5-17 17-8 3 3-8Z" />
			<path d="m51 40 5 5" />
			<path d="m7 7 2-3m2 5 3-2" />
		</g>
	)}
	{kind === "READ" && (
		<g>
			<path d="M36 19c-7-6-17-7-27-4v39c10-3 20-2 27 4 7-6 17-7 27-4V15c-10-3-20-2-27 4Z" />
			<path d="M36 19v39M15 24c6-1 11 0 16 3M15 31c6-1 11 0 16 3M41 27c5-3 10-4 16-3M41 34c5-3 10-4 16-3" />
			<path d="m53 5 1.5 4.5L59 11l-4.5 1.5L53 17l-1.5-4.5L47 11l4.5-1.5L53 5Z" />
		</g>
	)}
	{kind === "PLAN" && (
		<g>
			<rect x="10" y="16" width="52" height="44" rx="4" />
			<path d="M10 28h52M22 10v12M50 10v12M20 36h8M36 36h8M20 45h8" />
			<path d="m48 43 1.7 4.1 4.3.4-3.3 2.8 1 4.2-3.7-2.2-3.7 2.2 1-4.2-3.3-2.8 4.3-.4L48 43Z" />
			<path d="m62 6 2-2m2 6 3-1" />
		</g>
	)}
	{kind === "VIEW" && (
		<g>
			<path d="m15 12 48 7-7 43-48-7 7-43Z" />
			<path d="m19 20 36 5-4 25-36-5 4-25Z" />
			<circle cx="44" cy="32" r="3" />
			<path d="m17 42 10-9 8 9 6-5 11 12M6 63c10 3 19 3 27 1" />
			<path d="m8 7 1-4m4 6 3-3" />
		</g>
	)}
	{kind === "WORK" && (
		<g>
			<path d="M46 10c-12 4-21 13-24 25l15 15c12-3 21-12 25-24l-16-16Z" />
			<path d="m22 35-9 2-5 12 14-3m15 4 3 14 12-5 2-9M27 45l-6 6M20 52l-5 7M28 54l-2 8" />
			<circle cx="45" cy="27" r="5" />
			<path d="m10 14 2-5 2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" />
		</g>
	)}
	{kind === "BOOK" && (
		<g>
			<path d="M10 17h17v39H10a4 4 0 0 1-4-4V21a4 4 0 0 1 4-4ZM27 21h17v35H27M44 14h17v42H44" />
			<path d="M13 25h10M13 30h10M31 28h9M31 33h9M48 23h9M48 29h9M4 58h63" />
			<path d="M54 14v18l-4-3-4 3V14" />
			<path d="m63 6 2-3m1 8 3-1" />
		</g>
	)}
</svg>
