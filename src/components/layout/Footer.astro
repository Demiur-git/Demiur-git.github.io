---
import fs from "node:fs";
import path from "node:path";
import { ocPetConfig, profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
const reserveLeftPetSpace =
	ocPetConfig.enable && (ocPetConfig.position ?? "bottom-left") === "bottom-left";
const footerLinks = [
	{ label: "文章归档", meta: "ARCHIVE", href: url("/archive/") },
	{ label: "关于本站", meta: "ABOUT", href: url("/about/site/") },
	{ label: "订阅更新", meta: "RSS ↗", href: url("rss.xml"), external: true },
	{ label: "联系作者", meta: "CONTACT", href: url("/about/me/") },
];

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs.readFileSync(footerHtmlPath, "utf-8");
	// 移除HTML注释
	customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
} catch (error) {
	console.warn(
		"FooterConfig.html 读取失败:",
		error instanceof Error ? error.message : String(error),
	);
}
---

<!-- 页脚：普通流位于文档末尾。site-footer 是 immersive-reading 的隐藏选择器，
     pointer-events-auto 用于覆盖首页 banner 下父级的 pointer-events: none，两者勿删 -->
<footer
	class:list={[
		"site-footer pointer-events-auto pb-4 md:pb-6",
		reserveLeftPetSpace && "site-footer--pet-left",
	]}
>
	<section class="footer-sheet" aria-labelledby="footer-title">
		<h2 id="footer-title" class="sr-only">网站页脚</h2>
		<div class="footer-binding" aria-hidden="true"></div>
		<div class="footer-fold" aria-hidden="true"></div>

		<div class="footer-sheet-content">
			{
				customFooterHtml && (
					<div class="footer-custom" set:html={customFooterHtml} />
				)
			}

			<div class="footer-ledger">
				<div class="footer-identity">
					<p class="footer-eyebrow">
						<span>LIBRARY COLOPHON</span>
						<span aria-hidden="true">·</span>
						<span>END PAGE</span>
					</p>
					<p class="footer-copyright">
						&copy; <span id="copyright-year">{currentYear}</span>
						{" "}{profileConfig.name}. All Rights Reserved.
					</p>

					<!--
						注意：请勿随意修改或删除 "Powered by Astro & Firefly" 部分，这是对开源项目的尊重和支持。
						需要增加底部内容时，直接编辑 src/config/FooterConfig.html 即可，不需要修改 Footer.astro。
					-->
					<p class="footer-powered">
						<span>Powered by</span>
						<a target="_blank" rel="noopener noreferrer" href="https://astro.build">Astro</a>
						<span aria-hidden="true">&</span>
						<a
							target="_blank"
							rel="noopener noreferrer"
							href="https://github.com/CuteLeaf/Firefly">Firefly</a
						>
					</p>
				</div>

				<nav class="footer-links" aria-label="页脚导航">
					{
						footerLinks.map((link) => (
							<a
								href={link.href}
								target={link.external ? "_blank" : undefined}
								rel={link.external ? "noopener noreferrer" : undefined}
							>
								<span>{link.label}</span>
								<small>{link.meta}</small>
							</a>
						))
					}
				</nav>
			</div>
		</div>
	</section>
</footer>

<style>
	.site-footer {
		--footer-paper: #fffaf0;
		--footer-paper-deep: #f1e6d1;
		--footer-ink: #40372f;
		--footer-muted: rgb(64 55 47 / 68%);
		--footer-rule: rgb(86 107 84 / 13%);
		--footer-margin: rgb(154 90 99 / 48%);
		--footer-accent: var(--library-burgundy);
		margin-top: auto;
		padding-top: 2.5rem;
		color: var(--footer-ink);
	}

	.footer-sheet {
		position: relative;
		isolation: isolate;
		min-height: 11rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--library-wood) 28%, transparent);
		border-radius: 0.9rem 0.9rem 0.58rem 0.58rem;
		background:
			linear-gradient(90deg, transparent 0 4.15rem, var(--footer-margin) 4.15rem 4.22rem, transparent 4.22rem),
			repeating-linear-gradient(0deg, transparent 0 1.82rem, var(--footer-rule) 1.82rem 1.88rem),
			linear-gradient(145deg, rgb(255 255 255 / 62%), transparent 38%),
			var(--footer-paper);
		box-shadow:
			0 1px 0 var(--footer-paper-deep),
			0 5px 0 -2px color-mix(in srgb, var(--footer-paper-deep) 88%, var(--library-wood)),
			0 18px 42px rgb(52 37 24 / 18%);
		backdrop-filter: blur(12px);
	}

	.footer-sheet::before {
		position: absolute;
		inset: 0.65rem 0.75rem -0.65rem;
		z-index: -1;
		border: 1px solid color-mix(in srgb, var(--library-wood) 18%, transparent);
		border-radius: inherit;
		content: "";
		transform: rotate(0.12deg);
	}

	.footer-sheet-content {
		position: relative;
		z-index: 2;
		padding: clamp(1.45rem, 3vw, 2.25rem) clamp(1.25rem, 4vw, 3.5rem);
	}

	.site-footer--pet-left .footer-sheet-content {
		padding-left: max(11.5rem, 13vw);
	}

	.footer-binding {
		position: absolute;
		top: 1rem;
		bottom: 1rem;
		left: 1.58rem;
		width: 0.68rem;
		background: radial-gradient(circle, color-mix(in srgb, var(--library-wood) 34%, transparent) 0 2px, transparent 2.5px) center top / 0.68rem 1.55rem repeat-y;
		opacity: 0.72;
	}

	.footer-fold {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 3;
		width: 2.65rem;
		height: 2.65rem;
		background: linear-gradient(225deg, var(--footer-paper-deep) 0 48%, rgb(75 53 36 / 16%) 49% 52%, transparent 53%);
		clip-path: polygon(0 0, 100% 0, 100% 100%);
		pointer-events: none;
	}

	.footer-custom {
		margin-bottom: 1.15rem;
		border-bottom: 1px dashed color-mix(in srgb, var(--footer-accent) 35%, transparent);
		padding-bottom: 0.9rem;
		color: var(--footer-muted);
		font-size: 0.82rem;
		line-height: 1.75;
		overflow-wrap: anywhere;
	}

	.footer-ledger {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
		gap: clamp(1.5rem, 5vw, 4.5rem);
		align-items: center;
	}

	.footer-identity,
	.footer-links {
		min-width: 0;
	}

	.footer-eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0 0 0.75rem;
		color: var(--library-moss);
		font-family: var(--font-code);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.footer-copyright {
		margin: 0;
		color: var(--footer-ink);
		font-family: var(--font-library-serif);
		font-size: clamp(0.92rem, 1.4vw, 1.08rem);
		font-weight: 620;
		line-height: 1.75;
		overflow-wrap: anywhere;
	}

	.footer-powered {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.65rem 0 0;
		color: var(--footer-muted);
		font-size: 0.72rem;
	}

	.footer-powered a {
		color: var(--library-moss);
		font-weight: 700;
		text-decoration: none;
	}

	.footer-powered a:hover,
	.footer-powered a:focus-visible {
		color: var(--footer-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 1.25rem;
	}

	.footer-links a {
		display: flex;
		min-width: 0;
		min-height: 2.7rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-bottom: 1px solid color-mix(in srgb, var(--library-moss) 25%, transparent);
		padding: 0.5rem 0.15rem;
		color: var(--footer-ink);
		text-decoration: none;
		transition: color 180ms ease, border-color 180ms ease, padding 180ms ease;
	}

	.footer-links a span {
		font-family: var(--font-library-serif);
		font-size: 0.78rem;
		font-weight: 580;
		white-space: nowrap;
	}

	.footer-links a small {
		color: var(--footer-muted);
		font-family: var(--font-code);
		font-size: 0.54rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		white-space: nowrap;
	}

	.footer-links a:hover,
	.footer-links a:focus-visible {
		border-color: var(--footer-accent);
		color: var(--footer-accent);
		padding-left: 0.45rem;
	}

	.footer-powered a:focus-visible,
	.footer-links a:focus-visible {
		outline: 2px solid var(--footer-accent);
		outline-offset: 3px;
	}

	:global(:root.dark) .site-footer {
		--footer-paper: #17211c;
		--footer-paper-deep: #101914;
		--footer-ink: #eee8dc;
		--footer-muted: rgb(238 232 220 / 72%);
		--footer-rule: rgb(210 180 122 / 12%);
		--footer-margin: rgb(192 124 135 / 42%);
		--footer-accent: var(--library-brass);
	}

	:global(:root.dark) .footer-sheet {
		border-color: rgb(210 180 122 / 24%);
		background:
			linear-gradient(90deg, transparent 0 4.15rem, var(--footer-margin) 4.15rem 4.22rem, transparent 4.22rem),
			repeating-linear-gradient(0deg, transparent 0 1.82rem, var(--footer-rule) 1.82rem 1.88rem),
			linear-gradient(145deg, rgb(255 255 255 / 3%), transparent 38%),
			color-mix(in srgb, var(--footer-paper) 94%, transparent);
		box-shadow:
			0 1px 0 var(--footer-paper-deep),
			0 5px 0 -2px #0a110d,
			0 18px 46px rgb(0 0 0 / 32%);
	}

	@media (max-width: 899px) {
		.footer-ledger {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}
	}

	@media (max-width: 640px) {
		.site-footer {
			padding-top: 1.75rem;
		}

		.footer-sheet {
			border-radius: 0.72rem 0.72rem 0.42rem 0.42rem;
			background:
				linear-gradient(90deg, transparent 0 2.8rem, var(--footer-margin) 2.8rem 2.86rem, transparent 2.86rem),
				repeating-linear-gradient(0deg, transparent 0 1.72rem, var(--footer-rule) 1.72rem 1.78rem),
				linear-gradient(145deg, rgb(255 255 255 / 48%), transparent 38%),
				var(--footer-paper);
		}

		:global(:root.dark) .footer-sheet {
			background:
				linear-gradient(90deg, transparent 0 2.8rem, var(--footer-margin) 2.8rem 2.86rem, transparent 2.86rem),
				repeating-linear-gradient(0deg, transparent 0 1.72rem, var(--footer-rule) 1.72rem 1.78rem),
				linear-gradient(145deg, rgb(255 255 255 / 3%), transparent 38%),
				color-mix(in srgb, var(--footer-paper) 94%, transparent);
		}

		.footer-sheet-content {
			padding: 1.35rem 1rem 1.3rem;
		}

		.site-footer--pet-left .footer-sheet-content {
			min-height: 9rem;
			padding-left: 7.5rem;
		}

		.footer-binding {
			left: 0.95rem;
		}

		.footer-links {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-links a {
			transition: none;
		}

		.footer-links a:hover,
		.footer-links a:focus-visible {
			padding-left: 0.15rem;
		}
	}
</style>
