---
import { Icon } from "astro-icon/components";
import { homeIntroConfig } from "@/config";
---

<section class="home-intro mb-8" aria-labelledby="home-intro-title">
	<div class="home-intro-card card-base relative overflow-hidden px-7 py-10 sm:px-10 sm:py-12 lg:px-14 lg:py-14">
		<div class="home-intro-rule" aria-hidden="true"></div>
		<div class="relative z-10 max-w-3xl">
			<p class="home-intro-eyebrow">{homeIntroConfig.eyebrow}</p>
			<h2 id="home-intro-title" class="home-intro-title mt-4 text-3xl font-bold leading-tight text-90 sm:text-4xl lg:text-5xl">
				{homeIntroConfig.title}
			</h2>
			<p class="mt-5 max-w-2xl text-sm leading-7 text-50 sm:text-base sm:leading-8">
				{homeIntroConfig.description}
			</p>
		</div>

		<div class="home-intro-index" aria-hidden="true">
			<span>INDEX</span>
			<strong>01</strong>
		</div>
	</div>

	<nav class="home-intro-links" aria-label="社交链接">
		{
			homeIntroConfig.links.map((link) => (
				<a
					class="home-intro-link"
					href={link.url}
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noopener noreferrer" : undefined}
					aria-label={link.name}
					title={link.name}
				>
					<Icon name={link.icon} aria-hidden="true" />
					<span>{link.name}</span>
				</a>
			))
		}
	</nav>
</section>

<style>
	.home-intro-card {
		isolation: isolate;
		background:
			linear-gradient(120deg, color-mix(in oklch, var(--primary) 8%, transparent), transparent 48%),
			var(--card-bg);
	}

	.home-intro-rule {
		position: absolute;
		inset: 1.25rem 1.25rem auto auto;
		width: min(28%, 15rem);
		height: 1px;
		background: color-mix(in oklch, var(--primary) 45%, transparent);
	}

	.home-intro-eyebrow {
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
	}

	.home-intro-title {
		max-width: 18ch;
		text-wrap: balance;
	}

	.home-intro-index {
		position: absolute;
		right: 1.5rem;
		bottom: 1.25rem;
		display: none;
		align-items: end;
		gap: 0.55rem;
		color: color-mix(in oklch, var(--primary) 32%, transparent);
		font-variant-numeric: tabular-nums;
	}

	.home-intro-index span {
		padding-bottom: 0.42rem;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.home-intro-index strong {
		font-size: 3.75rem;
		font-weight: 700;
		line-height: 0.8;
	}

	.home-intro-links {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: center;
		gap: 0.85rem;
		margin-top: -1.55rem;
	}

	.home-intro-link {
		display: inline-flex;
		width: 3.15rem;
		height: 3.15rem;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider));
		border-radius: 9999px;
		background: var(--card-bg);
		box-shadow: 0 0.55rem 1.4rem color-mix(in oklch, var(--primary) 10%, transparent);
		color: var(--primary);
		font-size: 1.18rem;
		transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
	}

	.home-intro-link span {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-intro-link:hover {
		transform: translateY(-0.25rem);
		background: var(--primary);
		box-shadow: 0 0.8rem 1.6rem color-mix(in oklch, var(--primary) 22%, transparent);
		color: white;
	}

	.home-intro-link:focus-visible {
		outline: 3px solid color-mix(in oklch, var(--primary) 35%, transparent);
		outline-offset: 3px;
	}

	@media (min-width: 640px) {
		.home-intro-index {
			display: flex;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-intro-link {
			transition: none;
		}
	}
</style>
