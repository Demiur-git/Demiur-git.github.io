---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { homeIntroConfig } from "@/config";
import { url } from "@/utils/url-utils";
---

<section class="library-home" aria-labelledby="home-intro-title">
	<article class="library-hero card-base">
		<div class="hero-copy">
			<div class="hero-copy-inner">
				<p class="hero-eyebrow">
					<Icon name="material-symbols:local-library-outline-rounded" aria-hidden="true" />
					<span>{homeIntroConfig.eyebrow}</span>
				</p>
				<h2 id="home-intro-title">{homeIntroConfig.title}</h2>
				<p class="hero-description">{homeIntroConfig.description}</p>

				<nav class="library-stamps" aria-label="社交链接">
					{
						homeIntroConfig.links.map((link) => (
							<a
								class="library-stamp"
								href={link.external ? link.url : url(link.url)}
								target={link.external ? "_blank" : undefined}
								rel={link.external ? "noopener noreferrer" : undefined}
								aria-label={link.name}
								title={link.name}
							>
								<span class="stamp-ring"><Icon name={link.icon} aria-hidden="true" /></span>
								<span>{link.name}</span>
							</a>
						))
					}
				</nav>
			</div>

			<div class="hero-ledger" aria-hidden="true">
				<span>CATALOG</span>
				<strong>001</strong>
			</div>
		</div>

		<figure class="hero-artwork" aria-hidden="true">
			<Picture
				src={homeIntroConfig.heroArtwork.src}
				alt={homeIntroConfig.heroArtwork.alt}
				formats={["avif"]}
				fallbackFormat="webp"
				widths={[560, 840, 1120]}
				sizes="(max-width: 899px) 100vw, 48vw"
				loading="eager"
				fetchpriority="high"
				class="hero-artwork-image"
				style={`object-position: ${homeIntroConfig.heroArtwork.position ?? "center"};`}
			/>
			<div class="artwork-wash"></div>
			<div class="checkout-slip">
				<span>OPEN SHELF</span>
				<strong>欢迎阅览</strong>
			</div>
		</figure>
	</article>

	<section class="catalog-section" aria-labelledby="catalog-title">
		<header class="section-heading">
			<div>
				<p>{homeIntroConfig.catalogEyebrow}</p>
				<h2 id="catalog-title">{homeIntroConfig.catalogTitle}</h2>
			</div>
			<span>{homeIntroConfig.catalogDescription}</span>
		</header>

		<div class="catalog-grid">
			{
				homeIntroConfig.catalogEntries.map((entry) => (
					<a class={`catalog-card tone-${entry.tone}`} href={url(entry.url)}>
						<span class="catalog-code">{entry.code}</span>
						<span class="catalog-icon" aria-hidden="true">
							<Icon name={entry.icon} />
						</span>
						<span class="catalog-copy">
							<strong>{entry.name}</strong>
							<small>{entry.description}</small>
						</span>
						<Icon class="catalog-arrow" name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
					</a>
				))
			}
		</div>
	</section>

	<header class="section-heading latest-heading">
		<div>
			<p>RECENT ARRIVALS</p>
			<h2>最近更新</h2>
		</div>
		<span>新近入藏的文章与记录。</span>
	</header>
</section>

<style>
	.library-home {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-bottom: 1rem;
	}

	.library-hero {
		display: grid;
		min-height: 30rem;
		grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.96fr);
		isolation: isolate;
		overflow: hidden;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		display: flex;
		min-width: 0;
		align-items: center;
		padding: clamp(2rem, 5vw, 4.8rem);
		background:
			linear-gradient(90deg, var(--card-bg) 0 72%, color-mix(in srgb, var(--card-bg) 68%, transparent) 89%, transparent),
			repeating-linear-gradient(0deg, transparent 0 2rem, color-mix(in srgb, var(--library-wood) 5%, transparent) 2.05rem);
	}

	.hero-copy::before {
		position: absolute;
		top: 1.4rem;
		left: 1.4rem;
		width: 3.4rem;
		height: 0.28rem;
		border-radius: 999px;
		content: "";
		background: var(--library-burgundy);
	}

	.hero-copy-inner {
		max-width: 36rem;
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		color: var(--library-moss);
		font-family: var(--font-code);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.hero-eyebrow :global(svg) {
		font-size: 1.25rem;
	}

	.hero-copy h2 {
		max-width: 11ch;
		margin: 1.15rem 0 0;
		color: var(--library-ink);
		font-size: clamp(2.2rem, 4.1vw, 4.2rem);
		font-weight: 680;
		letter-spacing: -0.035em;
		line-height: 1.2;
		text-wrap: balance;
	}

	.hero-description {
		max-width: 38rem;
		margin: 1.4rem 0 0;
		color: var(--content-meta);
		font-size: 0.95rem;
		line-height: 1.9;
	}

	.library-stamps {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.library-stamp {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--content-meta);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease;
	}

	.stamp-ring {
		display: grid;
		width: 2.85rem;
		height: 2.85rem;
		place-items: center;
		border: 1px dashed color-mix(in srgb, var(--library-burgundy) 66%, var(--line-color));
		border-radius: 50%;
		background: color-mix(in srgb, var(--library-burgundy) 7%, var(--card-bg));
		box-shadow: inset 0 0 0 0.28rem var(--card-bg);
		color: var(--library-burgundy);
		font-size: 1.05rem;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.library-stamp:hover,
	.library-stamp:focus-visible {
		color: var(--library-burgundy);
		transform: translateY(-2px);
	}

	.library-stamp:hover .stamp-ring,
	.library-stamp:focus-visible .stamp-ring {
		background: var(--library-burgundy);
		color: var(--library-surface);
		transform: rotate(-4deg);
	}

	.hero-ledger {
		position: absolute;
		right: 1.5rem;
		bottom: 1.35rem;
		display: flex;
		align-items: end;
		gap: 0.55rem;
		color: color-mix(in srgb, var(--library-wood) 42%, transparent);
		font-family: var(--font-code);
	}

	.hero-ledger span {
		padding-bottom: 0.3rem;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.hero-ledger strong {
		font-size: 2.5rem;
		font-weight: 500;
		line-height: 0.8;
	}

	.hero-artwork {
		position: relative;
		min-width: 0;
		min-height: 30rem;
		margin: 0;
		overflow: hidden;
		background: var(--library-wood);
	}

	.hero-artwork :global(picture),
	.hero-artwork :global(.hero-artwork-image) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-artwork :global(.hero-artwork-image) {
		object-fit: cover;
		filter: saturate(0.84) contrast(0.96);
		transform: scale(1.015);
	}

	.artwork-wash {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, var(--card-bg) 0, transparent 13%),
			linear-gradient(180deg, transparent 58%, rgb(48 36 26 / 26%));
		pointer-events: none;
	}

	.checkout-slip {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		display: flex;
		min-width: 8.5rem;
		flex-direction: column;
		gap: 0.2rem;
		border: 1px solid rgb(107 75 54 / 22%);
		border-radius: 0.35rem;
		padding: 0.65rem 0.8rem;
		background: rgb(255 253 248 / 88%);
		box-shadow: 0 10px 24px rgb(48 36 26 / 18%);
		color: #4e4136;
		transform: rotate(-1.5deg);
	}

	.checkout-slip span {
		font-family: var(--font-code);
		font-size: 0.52rem;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	.checkout-slip strong {
		font-family: var(--font-library-serif);
		font-size: 0.86rem;
	}

	.catalog-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0 0.25rem;
	}

	.section-heading p {
		margin: 0 0 0.25rem;
		color: var(--library-moss);
		font-family: var(--font-code);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--library-ink);
		font-size: clamp(1.55rem, 3vw, 2.2rem);
		line-height: 1.25;
	}

	.section-heading > span {
		max-width: 28rem;
		padding-bottom: 0.2rem;
		color: var(--content-meta);
		font-size: 0.78rem;
		line-height: 1.7;
		text-align: right;
	}

	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.catalog-card {
		--catalog-accent: var(--library-moss);
		position: relative;
		display: grid;
		min-height: 10.2rem;
		grid-template-columns: auto 1fr auto;
		grid-template-rows: auto 1fr;
		gap: 0.7rem 0.85rem;
		align-items: center;
		overflow: hidden;
		border: 1px solid var(--library-rule);
		border-radius: var(--radius-large);
		padding: 1.1rem;
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--catalog-accent) 8%, transparent), transparent 52%),
			var(--card-bg);
		box-shadow: 0 10px 28px rgb(69 51 36 / 6%);
		color: inherit;
		text-decoration: none;
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.catalog-card::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 0.24rem;
		content: "";
		background: var(--catalog-accent);
	}

	.catalog-card.tone-burgundy {
		--catalog-accent: var(--library-burgundy);
	}

	.catalog-card.tone-brass {
		--catalog-accent: var(--library-brass);
	}

	.catalog-card:hover,
	.catalog-card:focus-visible {
		border-color: color-mix(in srgb, var(--catalog-accent) 55%, var(--library-rule));
		box-shadow: 0 16px 34px color-mix(in srgb, var(--catalog-accent) 13%, transparent);
		transform: translateY(-3px);
	}

	.catalog-code {
		grid-column: 1 / -1;
		color: var(--catalog-accent);
		font-family: var(--font-code);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.13em;
	}

	.catalog-icon {
		display: grid;
		width: 2.65rem;
		height: 2.65rem;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--catalog-accent) 24%, transparent);
		border-radius: 0.65rem;
		background: color-mix(in srgb, var(--catalog-accent) 9%, transparent);
		color: var(--catalog-accent);
		font-size: 1.35rem;
	}

	.catalog-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.25rem;
	}

	.catalog-copy strong {
		color: var(--library-ink);
		font-family: var(--font-library-serif);
		font-size: 1.05rem;
	}

	.catalog-copy small {
		color: var(--content-meta);
		font-size: 0.7rem;
		line-height: 1.55;
	}

	.catalog-arrow {
		color: var(--catalog-accent);
		font-size: 1.2rem;
		transition: transform 180ms ease;
	}

	.catalog-card:hover .catalog-arrow,
	.catalog-card:focus-visible .catalog-arrow {
		transform: translateX(3px);
	}

	.latest-heading {
		margin-bottom: -1rem;
		padding-top: 0.35rem;
		border-top: 1px solid var(--library-rule);
	}

	:global(:root.dark) .hero-artwork :global(.hero-artwork-image) {
		filter: brightness(0.62) saturate(0.68) contrast(1.05);
	}

	:global(:root.dark) .artwork-wash {
		background:
			linear-gradient(90deg, var(--card-bg) 0, transparent 14%),
			linear-gradient(180deg, rgb(15 18 20 / 12%), rgb(15 18 20 / 46%));
	}

	@media (max-width: 899px) {
		.library-hero {
			grid-template-columns: 1fr;
		}

		.hero-copy {
			padding: 2.5rem clamp(1.5rem, 6vw, 3rem) 2.2rem;
			background:
				repeating-linear-gradient(0deg, transparent 0 2rem, color-mix(in srgb, var(--library-wood) 5%, transparent) 2.05rem),
				var(--card-bg);
		}

		.hero-copy h2 {
			max-width: 16ch;
		}

		.hero-ledger {
			display: none;
		}

		.hero-artwork {
			min-height: 19rem;
			max-height: 24rem;
		}

		.artwork-wash {
			background: linear-gradient(180deg, var(--card-bg) 0, transparent 15%, rgb(48 36 26 / 24%));
		}

		.catalog-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 599px) {
		.library-home {
			gap: 1.5rem;
		}

		.hero-copy {
			padding: 2.15rem 1.3rem 1.8rem;
		}

		.hero-copy h2 {
			font-size: clamp(2rem, 11vw, 3rem);
		}

		.hero-description {
			font-size: 0.86rem;
		}

		.library-stamps {
			gap: 0.8rem;
		}

		.library-stamp > span:last-child {
			display: none;
		}

		.hero-artwork {
			min-height: 15.5rem;
		}

		.hero-artwork :global(.hero-artwork-image) {
			object-position: 72% center !important;
		}

		.checkout-slip {
			right: 0.8rem;
			bottom: 0.8rem;
			min-width: 7.5rem;
		}

		.section-heading {
			align-items: start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.section-heading > span {
			padding: 0;
			text-align: left;
		}

		.catalog-grid {
			grid-template-columns: 1fr;
		}

		.catalog-card {
			min-height: 8.6rem;
		}

		.latest-heading {
			margin-bottom: -0.65rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.library-stamp,
		.stamp-ring,
		.catalog-card,
		.catalog-arrow {
			transition: none;
		}

		.catalog-card:hover,
		.catalog-card:focus-visible,
		.library-stamp:hover,
		.library-stamp:focus-visible {
			transform: none;
		}
	}
</style>
