---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import MusicMiniPlayer from "@/components/features/MusicMiniPlayer.svelte";
import PulseClue from "@/components/features/PulseClue.astro";
import CatalogDoodle from "@/components/layout/CatalogDoodle.astro";
import { homeIntroConfig } from "@/config";
import { url } from "@/utils/url-utils";
---

<section class="library-home" aria-labelledby="home-intro-title">
	<article class="library-hero card-base">
		<div class="hero-copy">
			<div class="hero-copy-inner">
				<p class="hero-eyebrow">
					<Icon name="material-symbols:local-library-outline-rounded" aria-hidden="true" />
					<span>{homeIntroConfig.eyebrow}</span>
				</p>
				<h2 id="home-intro-title">{homeIntroConfig.title}</h2>
				<p class="hero-description">{homeIntroConfig.description}</p>

				<nav class="library-stamps" aria-label="社交链接">
					{
						homeIntroConfig.links.map((link) => (
							<a
								class="library-stamp"
								href={link.external ? link.url : url(link.url)}
								target={link.external ? "_blank" : undefined}
								rel={link.external ? "noopener noreferrer" : undefined}
								aria-label={link.name}
								title={link.name}
							>
								<span class="stamp-ring"><Icon name={link.icon} aria-hidden="true" /></span>
								<span>{link.name}</span>
							</a>
						))
					}
				</nav>
			</div>

			<div class="hero-ledger" aria-hidden="true">
				<span>CATALOG</span>
				<strong>001</strong>
			</div>
		</div>

		<figure class="hero-artwork" aria-hidden="true">
			<div class="hero-theme-images" data-theme-image data-theme-priority="high">
				<template data-wallpaper-theme="light">
					<Picture
						src={homeIntroConfig.heroArtwork.src}
						alt={homeIntroConfig.heroArtwork.alt}
						formats={["avif"]}
						fallbackFormat="webp"
						widths={[560, 840, 1120]}
						sizes="(max-width: 899px) 100vw, 48vw"
						loading="eager"
						fetchpriority="high"
						class="hero-artwork-image"
						style={`object-position: ${homeIntroConfig.heroArtwork.position ?? "center"};`}
					/>
				</template>
				<template data-wallpaper-theme="dark">
					<Picture
						src={homeIntroConfig.heroArtwork.darkSrc ?? homeIntroConfig.heroArtwork.src}
						alt={homeIntroConfig.heroArtwork.alt}
						formats={["avif"]}
						fallbackFormat="webp"
						widths={[560, 840, 1120]}
						sizes="(max-width: 899px) 100vw, 48vw"
						loading="eager"
						fetchpriority="high"
						class="hero-artwork-image"
						style={`object-position: ${homeIntroConfig.heroArtwork.position ?? "center"};`}
					/>
				</template>
			</div>
			<div class="artwork-wash"></div>
			<div class="checkout-slip">
				<span>OPEN SHELF</span>
				<strong>欢迎阅览</strong>
			</div>
		</figure>
	</article>

	<div class="home-lower">
		<section class="catalog-section" aria-labelledby="catalog-title">
			<PulseClue clue="home" />
			<header class="section-heading">
				<div>
					<p>{homeIntroConfig.catalogEyebrow}</p>
					<h2 id="catalog-title">{homeIntroConfig.catalogTitle}</h2>
				</div>
				<span>{homeIntroConfig.catalogDescription}</span>
			</header>

			<nav class="catalog-wall" aria-label="馆藏目录入口">
				{
					homeIntroConfig.catalogEntries.map((entry) => (
						<a
							class={`catalog-note tone-${entry.tone}`}
							href={url(entry.url)}
							aria-label={`${entry.name}：${entry.description}`}
						>
							<span class="note-tape" aria-hidden="true"></span>
							<span class="note-code">{entry.code}</span>
							<span class="note-illustration" aria-hidden="true">
								<CatalogDoodle code={entry.code} />
							</span>
							<span class="note-copy">
								<strong>{entry.name}</strong>
								<small>{entry.description}</small>
							</span>
							<span class="note-corner" aria-hidden="true"></span>
						</a>
					))
				}
			</nav>
		</section>

		<aside class="home-sidebar" aria-label="主页侧边栏">
			<MusicMiniPlayer variant="sidebar" musicHref={url("/music/")} client:load />
		</aside>

	</div>
</section>

<style>
	.library-home {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-bottom: 1rem;
	}

	.home-lower {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(15rem, 17.5rem);
		gap: 1.4rem;
		align-items: start;
	}

	.home-sidebar {
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
	}


	.library-hero {
		display: grid;
		min-height: 30rem;
		grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.96fr);
		isolation: isolate;
		overflow: hidden;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		display: flex;
		min-width: 0;
		align-items: center;
		padding: clamp(2rem, 5vw, 4.8rem);
		background:
			linear-gradient(90deg, var(--card-bg) 0 72%, color-mix(in srgb, var(--card-bg) 68%, transparent) 89%, transparent),
			repeating-linear-gradient(0deg, transparent 0 2rem, color-mix(in srgb, var(--library-wood) 5%, transparent) 2.05rem);
	}

	.hero-copy::before {
		position: absolute;
		top: 1.4rem;
		left: 1.4rem;
		width: 3.4rem;
		height: 0.28rem;
		border-radius: 999px;
		content: "";
		background: var(--library-burgundy);
	}

	.hero-copy-inner {
		max-width: 36rem;
	}

	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0;
		color: var(--library-moss);
		font-family: var(--font-code);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.hero-eyebrow :global(svg) {
		font-size: 1.25rem;
	}

	.hero-copy h2 {
		max-width: 11ch;
		margin: 1.15rem 0 0;
		color: var(--library-ink);
		font-size: clamp(2.2rem, 4.1vw, 4.2rem);
		font-weight: 680;
		letter-spacing: -0.035em;
		line-height: 1.2;
		text-wrap: balance;
	}

	.hero-description {
		max-width: 38rem;
		margin: 1.4rem 0 0;
		color: var(--content-meta);
		font-size: 0.95rem;
		line-height: 1.9;
	}

	.library-stamps {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.library-stamp {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--content-meta);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease;
	}

	.stamp-ring {
		display: grid;
		width: 2.85rem;
		height: 2.85rem;
		place-items: center;
		border: 1px dashed color-mix(in srgb, var(--library-burgundy) 66%, var(--line-color));
		border-radius: 50%;
		background: color-mix(in srgb, var(--library-burgundy) 7%, var(--card-bg));
		box-shadow: inset 0 0 0 0.28rem var(--card-bg);
		color: var(--library-burgundy);
		font-size: 1.05rem;
		transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.library-stamp:hover,
	.library-stamp:focus-visible {
		color: var(--library-burgundy);
		transform: translateY(-2px);
	}

	.library-stamp:hover .stamp-ring,
	.library-stamp:focus-visible .stamp-ring {
		background: var(--library-burgundy);
		color: var(--library-surface);
		transform: rotate(-4deg);
	}

	.hero-ledger {
		position: absolute;
		right: 1.5rem;
		bottom: 1.35rem;
		display: flex;
		align-items: end;
		gap: 0.55rem;
		color: color-mix(in srgb, var(--library-wood) 42%, transparent);
		font-family: var(--font-code);
	}

	.hero-ledger span {
		padding-bottom: 0.3rem;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.hero-ledger strong {
		font-size: 2.5rem;
		font-weight: 500;
		line-height: 0.8;
	}

	.hero-artwork {
		position: relative;
		min-width: 0;
		min-height: 30rem;
		margin: 0;
		overflow: hidden;
		background: var(--library-wood);
	}

	.hero-artwork :global(picture),
	.hero-artwork :global(.hero-artwork-image) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-theme-images {
		position: absolute;
		inset: 0;
	}

	.hero-artwork :global(.hero-artwork-image) {
		object-fit: cover;
		filter: saturate(0.84) contrast(0.96);
		transform: scale(1.015);
	}

	.artwork-wash {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, var(--card-bg) 0, transparent 13%),
			linear-gradient(180deg, transparent 58%, rgb(48 36 26 / 26%));
		pointer-events: none;
	}

	.checkout-slip {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		display: flex;
		min-width: 8.5rem;
		flex-direction: column;
		gap: 0.2rem;
		border: 1px solid rgb(107 75 54 / 22%);
		border-radius: 0.35rem;
		padding: 0.65rem 0.8rem;
		background: rgb(255 253 248 / 88%);
		box-shadow: 0 10px 24px rgb(48 36 26 / 18%);
		color: #4e4136;
		transform: rotate(-1.5deg);
	}

	.checkout-slip span {
		font-family: var(--font-code);
		font-size: 0.52rem;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	.checkout-slip strong {
		font-family: var(--font-library-serif);
		font-size: 0.86rem;
	}

	.catalog-section {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.catalog-section > .section-heading { padding-right:44px; }

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem;
		border: 1px solid var(--library-rule);
		border-radius: 0.8rem;
		padding: 0.72rem 0.9rem;
		background: color-mix(in srgb, var(--card-bg) 84%, transparent);
		box-shadow: 0 8px 24px rgb(45 34 26 / 5%);
		backdrop-filter: blur(10px);
	}

	.section-heading p {
		margin: 0 0 0.25rem;
		color: var(--library-moss);
		font-family: var(--font-code);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--library-ink);
		font-size: clamp(1.55rem, 3vw, 2.2rem);
		line-height: 1.25;
	}

	.section-heading > span {
		max-width: 28rem;
		padding-bottom: 0.2rem;
		color: var(--content-meta);
		font-size: 0.78rem;
		line-height: 1.7;
		text-align: right;
	}

	.catalog-section > .section-heading {
		border: 0;
		border-radius: 0;
		padding: 0.25rem 0.35rem 0.45rem;
		background: none;
		box-shadow: none;
		backdrop-filter: none;
	}

	.catalog-section > .section-heading > div {
		transform: rotate(-2deg);
	}

	.catalog-section > .section-heading p,
	.catalog-section > .section-heading h2,
	.catalog-section > .section-heading > span {
		color: #fff9ef;
		text-shadow: 0 1px 3px rgb(25 17 13 / 85%), 0 0 12px rgb(25 17 13 / 70%);
	}

	.catalog-section > .section-heading h2 {
		font-size: clamp(1.4rem, 2.3vw, 1.8rem);
	}

	.catalog-section > .section-heading > span {
		padding: 0;
	}

	.catalog-wall {
		--note-ink: #35312d;
		--note-rule: rgb(98 83 66 / 9%);
		--tape-color: rgb(231 220 192 / 85%);
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(12.7rem, auto));
		gap: 1.5rem 0.15rem;
		padding: 0.8rem 0.85rem 1.3rem;
		isolation: isolate;
	}

	:global(:root.dark) .catalog-wall {
		--note-ink: #eee7db;
		--note-rule: rgb(234 223 201 / 9%);
		--tape-color: rgb(128 119 103 / 72%);
	}

	.catalog-note {
		--note-paper: #f5ead5;
		--note-accent: #5c7764;
		--note-x: 0px;
		--note-y: 0px;
		--note-rotate: 0deg;
		--tape-rotate: -5deg;
		position: relative;
		z-index: 1;
		display: block;
		width: min(100%, 17rem);
		min-height: 12.25rem;
		justify-self: center;
		border: 1px solid color-mix(in srgb, var(--note-ink) 15%, transparent);
		border-radius: 0.15rem 0.22rem 0.32rem 0.18rem;
		background:
			repeating-linear-gradient(0deg, transparent 0 1.4rem, var(--note-rule) 1.43rem 1.46rem),
			linear-gradient(145deg, rgb(255 255 255 / 24%), transparent 48%),
			var(--note-paper);
		box-shadow: 0 0.9rem 1.35rem rgb(29 21 15 / 27%), inset 0 1px 0 rgb(255 255 255 / 33%);
		color: var(--note-ink);
		text-decoration: none;
		transform: translate(var(--note-x), var(--note-y)) rotate(var(--note-rotate));
		transition: transform 200ms ease, box-shadow 200ms ease;
	}

	.catalog-note.tone-burgundy {
		--note-accent: #a36573;
	}

	.catalog-note.tone-brass {
		--note-accent: #9d7b47;
	}

	:global(:root.dark) .catalog-note.tone-moss {
		--note-accent: #a4bca8;
	}

	:global(:root.dark) .catalog-note.tone-burgundy {
		--note-accent: #d6a1ab;
	}

	:global(:root.dark) .catalog-note.tone-brass {
		--note-accent: #d9b988;
	}

	.catalog-note:nth-child(1) {
		grid-column: 1 / span 4;
		grid-row: 1;
		--note-paper: #f5ebd5;
		--note-x: 0.2rem;
		--note-y: 0.75rem;
		--note-rotate: -4deg;
	}

	.catalog-note:nth-child(2) {
		grid-column: 5 / span 4;
		grid-row: 1;
		--note-paper: #f4e5e7;
		--note-y: -0.35rem;
		--note-rotate: 2.8deg;
		--tape-rotate: 7deg;
	}

	.catalog-note:nth-child(3) {
		grid-column: 9 / span 4;
		grid-row: 1;
		--note-paper: #e8efdf;
		--note-x: 0.25rem;
		--note-y: 0.6rem;
		--note-rotate: -2.5deg;
	}

	.catalog-note:nth-child(4) {
		grid-column: 2 / span 4;
		grid-row: 2;
		--note-paper: #e6edf0;
		--note-x: -0.3rem;
		--note-y: -0.2rem;
		--note-rotate: 3.2deg;
		--tape-rotate: -8deg;
	}

	.catalog-note:nth-child(5) {
		grid-column: 6 / span 4;
		grid-row: 2;
		--note-paper: #f4e9da;
		--note-y: 0.55rem;
		--note-rotate: -3.4deg;
	}

	.catalog-note:nth-child(6) {
		grid-column: 10 / span 3;
		grid-row: 2;
		--note-paper: #eee7d8;
		--note-x: 0.2rem;
		--note-y: -0.55rem;
		--note-rotate: 3.8deg;
		--tape-rotate: 4deg;
	}

	:global(:root.dark) .catalog-note:nth-child(1) {
		--note-paper: #303a34;
	}

	:global(:root.dark) .catalog-note:nth-child(2) {
		--note-paper: #403239;
	}

	:global(:root.dark) .catalog-note:nth-child(3) {
		--note-paper: #343b32;
	}

	:global(:root.dark) .catalog-note:nth-child(4) {
		--note-paper: #303b3e;
	}

	:global(:root.dark) .catalog-note:nth-child(5) {
		--note-paper: #40382f;
	}

	:global(:root.dark) .catalog-note:nth-child(6) {
		--note-paper: #39382e;
	}

	.note-tape {
		position: absolute;
		top: -0.4rem;
		left: calc(50% - 1.75rem);
		z-index: 2;
		width: 3.5rem;
		height: 1.05rem;
		border: 1px solid rgb(96 78 56 / 12%);
		background: repeating-linear-gradient(45deg, transparent 0 0.32rem, rgb(255 255 255 / 14%) 0.32rem 0.43rem), var(--tape-color);
		box-shadow: 0 0.18rem 0.3rem rgb(30 22 16 / 13%);
		pointer-events: none;
		transform: rotate(var(--tape-rotate));
	}

	.note-code {
		position: absolute;
		top: 0.8rem;
		left: 0.95rem;
		color: var(--note-accent);
		font-family: var(--font-code);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.note-illustration {
		position: absolute;
		top: 1.5rem;
		right: 1.05rem;
		width: 4.3rem;
		height: 4.3rem;
		color: var(--note-accent);
		opacity: 0.87;
		transform: rotate(-7deg);
	}

	.note-illustration :global(svg) {
		width: 100%;
		height: 100%;
	}

	.note-copy {
		position: absolute;
		right: 1rem;
		bottom: 0.9rem;
		left: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.note-copy strong {
		font-family: "Kaiti SC", STKaiti, KaiTi, var(--font-library-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		font-weight: 700;
		line-height: 1.2;
	}

	.note-copy small {
		font-size: 0.72rem;
		line-height: 1.55;
		opacity: 0.84;
	}

	.note-corner {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 1rem;
		height: 1rem;
		background: color-mix(in srgb, var(--note-ink) 11%, var(--note-paper));
		clip-path: polygon(0 100%, 100% 0, 100% 100%);
	}

	.catalog-note:focus-visible {
		z-index: 4;
		outline: 3px solid var(--library-burgundy);
		outline-offset: 4px;
		box-shadow: 0 1.2rem 1.6rem rgb(20 15 12 / 33%);
		transform: translate(var(--note-x), calc(var(--note-y) - 0.45rem)) rotate(var(--note-rotate)) scale(1.025);
	}

	@media (hover: hover) {
		.catalog-note:hover {
			z-index: 4;
			box-shadow: 0 1.2rem 1.6rem rgb(20 15 12 / 33%);
			transform: translate(var(--note-x), calc(var(--note-y) - 0.45rem)) rotate(var(--note-rotate)) scale(1.025);
		}

		:global(:root.dark) .catalog-note:hover {
			box-shadow: 0 1.2rem 1.6rem rgb(0 0 0 / 47%);
		}
	}


	@media (max-width: 1100px) {
		.home-lower {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-sidebar {
			grid-column: 1;
			grid-row: 2;
		}
	}

	:global(:root.dark) .artwork-wash {
		background: linear-gradient(90deg, var(--card-bg) 0, transparent 14%);
	}

	@media (max-width: 899px) {
		.library-hero {
			grid-template-columns: 1fr;
		}

		.hero-copy {
			padding: 2.5rem clamp(1.5rem, 6vw, 3rem) 2.2rem;
			background:
				repeating-linear-gradient(0deg, transparent 0 2rem, color-mix(in srgb, var(--library-wood) 5%, transparent) 2.05rem),
				var(--card-bg);
		}

		.hero-copy h2 {
			max-width: 16ch;
		}

		.hero-ledger {
			display: none;
		}

		.hero-artwork {
			min-height: 19rem;
			max-height: 24rem;
		}

		.artwork-wash {
			background: linear-gradient(180deg, var(--card-bg) 0, transparent 15%, rgb(48 36 26 / 24%));
		}

	}

	@media (max-width: 599px) {
		.library-home {
			gap: 1.5rem;
		}

		.hero-copy {
			padding: 2.15rem 1.3rem 1.8rem;
		}

		.hero-copy h2 {
			font-size: clamp(2rem, 11vw, 3rem);
		}

		.hero-description {
			font-size: 0.86rem;
		}

		.library-stamps {
			gap: 0.8rem;
		}

		.library-stamp > span:last-child {
			display: none;
		}

		.hero-artwork {
			min-height: 15.5rem;
		}

		.hero-artwork :global(.hero-artwork-image) {
			object-position: 72% center !important;
		}

		.checkout-slip {
			right: 0.8rem;
			bottom: 0.8rem;
			min-width: 7.5rem;
		}

		.section-heading {
			align-items: start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.section-heading > span {
			padding: 0;
			text-align: left;
		}

		.catalog-wall {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: none;
