---
import { pulseScenePath } from "@/utils/pulse-route";
---

<stillness-scene data-pagefind-ignore>
	<dialog class="stillness-screen" aria-label="静止的灰白空间" tabindex="-1">
		<div class="stillness-line" aria-hidden="true"></div>
		<div class="stillness-paper" aria-hidden="true"></div>
		<a class="stillness-return" data-scene-return href={pulseScenePath()} hidden>返回心电图</a>
	</dialog>
</stillness-scene>
<script>
	import { registerEasterEgg } from "@/utils/easter-egg-scene";
	import { StillnessScene } from "@/utils/stillness-scene";
	registerEasterEgg("stillness-scene", StillnessScene);
</script>
<style>
	.stillness-screen { position:fixed; inset:0; width:100vw; height:100dvh; max-width:none; max-height:none; margin:0; padding:0; border:0; overflow:hidden; background:#e5e5e5; color:#444; }
	.stillness-screen::backdrop { background:#e5e5e5; }
	.stillness-screen:focus { outline:none; }
	.stillness-line { position:absolute; top:50%; left:0; width:100%; height:1px; background:#858585; }
	.stillness-paper { position:absolute; left:50%; top:50%; width:min(340px,70vw); height:min(470px,64dvh); transform:translate(-50%,-50%) rotate(-1deg); border:1px solid #ffffff70; background:#ffffff30; box-shadow:0 3px 24px #5555550b; pointer-events:none; }
	.stillness-return { position:absolute; top:max(16px,env(safe-area-inset-top)); right:max(16px,env(safe-area-inset-right)); min-height:44px; padding:10px 16px; border:1px solid #999; background:#e5e5e5e8; color:#444; font-size:13px; text-decoration:none; }
	.stillness-return[hidden] { display:none; }
	.stillness-return:focus-visible { outline:2px solid #555; outline-offset:3px; }
	@media(max-width:480px) { .stillness-paper { width:min(72vw,310px); height:min(52dvh,420px); } }
</style>
