---
import { url } from "@/utils/url-utils";
---
<pulse-scene data-pagefind-ignore>
	<dialog class="pulse-screen" aria-label="装饰心电线场景" tabindex="-1">
		<div class="stillness-warning" aria-hidden="true"></div>
		<svg class="pulse-wave" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true"><g data-trail></g><path data-static fill="none" stroke="#111" stroke-width="1.4" vector-effect="non-scaling-stroke" /><circle data-scan-head r="2" fill="#111" visibility="hidden" /><path data-echo-residue fill="none" stroke="#777" stroke-opacity="0.43" stroke-width="1.1" vector-effect="non-scaling-stroke" visibility="hidden" /><path data-echo-primary fill="none" stroke="#111" stroke-width="1.6" vector-effect="non-scaling-stroke" visibility="hidden" /><path data-echo-ghost fill="none" stroke="#888" stroke-width="1.6" vector-effect="non-scaling-stroke" visibility="hidden" /></svg>
		<button class="wave-interaction" aria-label="让心电线停留：按住空格" data-wave-hold></button>
		<div class="stillness-keys" data-stillness-keys hidden><button type="button" data-stillness-key="J" aria-label="左侧节拍"></button><button type="button" data-stillness-key="K" aria-label="右侧节拍"></button></div>
		<button class="stillness-revisit" data-stillness-revisit type="button" aria-label="再次进入静止空间" hidden></button>
		<p class="stillness-status" data-stillness-status role="status"></p>
		<button class="echo-interaction" type="button" aria-label="没有消失的短线。按 Enter 或空格选取，再用方向键移动；也可拖动" data-echo-handle hidden></button>
		<p class="echo-status" data-echo-status role="status" aria-live="polite"></p>
		<button class="echo-leave" type="button" data-echo-leave hidden>松开第二条线</button>
		<section class="morse-panel" data-morse-panel hidden aria-label="摩斯输入">
			<p class="morse-heading">SIGNAL / INPUT</p>
			<div class="morse-readout" aria-live="polite"><span data-morse-symbols aria-label="当前点划"></span><strong data-morse-letters aria-label="已确认字母"></strong></div>
			<div class="morse-actions"><button data-morse-action="dot">↑ ·</button><button data-morse-action="dash">↓ —</button><button data-morse-action="confirm">确认字母 ↵</button><button data-morse-action="undo">退格</button><button data-morse-action="clear">清空</button><button data-morse-action="submit">提交</button><button data-morse-action="leave">收起模式</button></div>
			<p class="morse-status" data-morse-status role="status"></p>
			<a data-world-entry hidden href={url("/newworld/")}>进入深处</a>
			<a data-starfield-entry hidden href={url("/starfield/")}>进入星空</a>
		</section>
		<a class="pulse-return" data-scene-return href={url("/music/")} hidden>返回</a>
	</dialog>
</pulse-scene>
<script>
	import { PulseScene } from "@/utils/pulse-scene";
	import { registerEasterEgg } from "@/utils/easter-egg-scene";
	registerEasterEgg("pulse-scene", PulseScene);
</script>
<style>
	.pulse-screen { position:fixed; inset:0; margin:0; padding:0; border:0; width:100vw; height:100dvh; max-width:none; max-height:none; overflow:hidden; background:var(--stillness-bg,#fff); color:#111; overscroll-behavior:none; }
	.pulse-screen::backdrop { background:#fff; } .pulse-screen:focus { outline:none; }
	.stillness-warning { position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at center,transparent 34%,#671a240f 58%,#7117206b 100%); opacity:var(--stillness-warning,0); }
	.stillness-keys { position:absolute; z-index:2; left:50%; bottom:max(18px,env(safe-area-inset-bottom)); transform:translateX(-50%); display:flex; gap:36px; }
	.stillness-keys[hidden],.stillness-revisit[hidden] { display:none; }
	.stillness-keys button { position:relative; width:52px; height:48px; border:0; background:transparent; cursor:default; touch-action:manipulation; }
	.stillness-keys button::after { content:""; position:absolute; width:18px; height:1px; left:17px; top:24px; background:#7777; transform:rotate(-8deg); }
	.stillness-keys button:last-child::after { transform:rotate(8deg); }
	.stillness-keys button:focus-visible,.stillness-revisit:focus-visible { outline:1px dashed #777; outline-offset:2px; }
	.stillness-revisit { position:absolute; z-index:2; left:50%; top:calc(50% + min(20dvh,200px) - 28px); transform:translateX(-50%); width:64px; height:48px; border:0; background:transparent; }
	.stillness-revisit::after { content:""; display:block; width:36px; height:1px; margin:auto; background:#7779; }
	.stillness-status { position:absolute; z-index:2; left:50%; bottom:calc(72px + env(safe-area-inset-bottom)); transform:translateX(-50%); width:min(420px,calc(100vw - 32px)); margin:0; color:#777; font-size:12px; text-align:center; pointer-events:none; }
	.stillness-status:empty,pulse-scene[data-morse] .stillness-status,pulse-scene[data-echo] .stillness-status { display:none; }
	.pulse-wave { position:absolute; left:0; top:50%; width:100%; height:min(40dvh,400px); transform:translateY(-50%); pointer-events:none; }
	.wave-interaction { position:absolute; left:0; top:50%; width:100%; height:min(40dvh,400px); transform:translateY(-50%); background:transparent; touch-action:none; cursor:default; border:0; }
	.echo-interaction { position:absolute; z-index:1; left:var(--echo-hit-x,50%); top:var(--echo-hit-y,50%); width:44px; height:44px; transform:translate(-50%,-50%); border:0; background:transparent; touch-action:none; cursor:default; }
	.echo-interaction[hidden] { display:none; }
	.echo-interaction:focus-visible { outline:1px dashed #888; outline-offset:-5px; }
	.echo-status { position:absolute; left:50%; top:calc(50% + min(20dvh,200px) + 8px); transform:translateX(-50%); width:min(480px,calc(100vw - 32px)); margin:0; color:#666; text-align:center; font-size:12px; }
	.echo-status:empty { display:none; }
	.echo-leave { position:absolute; z-index:2; left:50%; top:calc(50% + min(20dvh,200px) + 34px); transform:translateX(-50%); min-height:40px; padding:8px 12px; border:1px solid #aaa; background:#fff; color:#333; font-size:12px; cursor:pointer; }
	.echo-leave[hidden] { display:none; }
	.echo-leave:focus-visible { outline:2px solid #111; outline-offset:3px; }
	pulse-scene[data-echo] .echo-interaction { left:0; top:30%; width:100%; height:40%; transform:none; }
	pulse-scene[data-echo] .wave-interaction,pulse-scene[data-morse] .echo-interaction { pointer-events:none; }
	pulse-scene[data-morse] .echo-interaction,pulse-scene[data-morse] .echo-status { display:none; }
	pulse-scene[data-flatline] .wave-interaction,pulse-scene[data-flatline] .echo-interaction { pointer-events:none; }
	pulse-scene[data-morse] .stillness-keys,pulse-scene[data-echo] .stillness-keys,pulse-scene[data-flatline] .stillness-keys { display:none; }
	pulse-scene[data-morse] .pulse-wave { height:clamp(100px,24vh,230px); }
	pulse-scene[data-morse] .wave-interaction { height:max(64px,24vh); }
	.wave-interaction:focus-visible { outline:1px dashed #777; outline-offset:-8px; }
	.morse-panel { position:absolute; left:50%; top:calc(50% + 110px); transform:translateX(-50%); width:min(520px,calc(100vw - 32px)); padding:1rem; border-top:1px solid #ccc; font-size:13px; }
	.morse-panel[hidden] { display:none; } .morse-heading { font:10px monospace; letter-spacing:.2em; color:#777; }
	.morse-panel { max-height:calc(50dvh - 126px); overflow-y:auto; overscroll-behavior:contain; }
	.morse-readout { min-height:48px; display:flex; justify-content:space-between; gap:12px; align-items:center; font:22px monospace; overflow-wrap:anywhere; }
	.morse-readout strong { font-size:16px; max-width:65%; }
	.morse-actions { display:flex; flex-wrap:wrap; gap:6px; } .morse-actions button { min-width:44px; min-height:44px; padding:6px 12px; border:1px solid #ccc; color:#222; background:#fff; cursor:pointer; }
	.morse-actions button:hover { border-color:#222; } .morse-panel :focus-visible { outline:2px solid #222; outline-offset:3px; }
	.morse-status { font-size:12px; line-height:1.6; margin-top:8px; min-height:20px; color:#666; }
	.morse-panel a { display:inline-block; margin-top:8px; padding:8px 12px; border:1px solid #333; } .morse-panel a[hidden] { display:none; }
	.pulse-return { position:absolute; bottom:max(28px,env(safe-area-inset-bottom)); right:28px; padding:10px 18px; color:#222; background:#fff; border:1px solid #bbb; font-size:14px; text-decoration:none; }
	.pulse-return[hidden] { display:none; } .pulse-return:focus-visible { outline:2px solid #111; outline-offset:4px; }
	@media(max-width:480px) { .morse-panel { top:calc(50% + 65px); max-height:calc(50dvh - 85px); padding:.75rem 0; } .morse-actions button { padding:5px 9px; font-size:12px; } .echo-leave { top:calc(50% + min(20dvh,200px) + 18px); } .stillness-keys { gap:42px; } }
	@media(max-height:520px) { .pulse-wave,.wave-interaction { top:30%; } pulse-scene[data-stillness-building] .pulse-wave,pulse-scene[data-stillness-building] .wave-interaction { top:50%; } pulse-scene[data-echo] .echo-interaction { top:10%; height:40%; } .echo-status { top:calc(30% + min(20dvh,200px) + 4px); } .echo-leave { top:calc(30% + min(20dvh,200px) + 26px); } .morse-panel { top:calc(30% + 50px); max-height:calc(70dvh - 66px); } .pulse-return { top:12px; bottom:auto; right:16px; } }
</style>
