<new-world-scene data-pagefind-ignore>
	<dialog class="world-screen" aria-label="黑色王座空间" tabindex="-1">
		<svg class="world-art" aria-hidden="true"><defs><filter id="throne-line-glow" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="1.2" /></filter></defs><g data-world-ripples></g><g data-world-throne></g></svg>
		<button class="world-forward" data-world-forward hidden aria-label="按住前行；键盘 W 或上方向键">前行</button>
		<section class="world-dialogue" data-world-dialogue hidden aria-label="王座对白">
			<header><span data-world-speaker>？？？</span><div><small data-world-count></small><button class="world-auto" data-world-auto aria-pressed="false" aria-label="自动推进：关闭"><svg viewBox="0 0 40 36" width="34" height="32" aria-hidden="true"><path d="M5 3L36 18L5 33Z" fill="none" stroke="currentColor" stroke-width="1.2" /><text x="16" y="23" text-anchor="middle" font-size="13" fill="currentColor">A</text></svg></button></div></header>
			<p class="world-words" data-world-words aria-hidden="true"></p><p class="sr-only" data-world-accessible aria-live="polite"></p><span class="world-caret" aria-hidden="true">▿</span>
		</section>
		<div class="world-choice" data-world-choice hidden><button data-world-home>返回主页</button><p data-world-error role="status"></p></div>
		<a class="world-return" data-scene-return href="../pulse/" hidden>返回心电图</a>
	</dialog>
</new-world-scene>
<script>
	import { NewWorldScene } from "@/utils/new-world-scene";
	import { registerEasterEgg } from "@/utils/easter-egg-scene";
	registerEasterEgg("new-world-scene", NewWorldScene);
</script>
<style>
	.world-screen { position:fixed; inset:0; margin:0; padding:0; border:0; width:100vw; height:100dvh; max-width:none; max-height:none; overflow:hidden; background:#000; color:#d1d4d4; overscroll-behavior:none; }
	.world-screen::backdrop { background:#000; } .world-screen:focus { outline:none; } .world-art { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
	.world-forward { position:absolute; left:50%; bottom:max(32px,env(safe-area-inset-bottom)); transform:translateX(-50%); background:#0b0e10cc; border:1px solid #40484c; color:#aeb5b7; min-height:44px; min-width:100px; padding:10px 20px; touch-action:none; }
	.world-forward[hidden],.world-dialogue[hidden],.world-return[hidden],.world-choice[hidden] { display:none; }
	.world-choice { position:absolute; left:50%; top:72%; transform:translate(-50%,-50%); width:min(520px,calc(100vw - 48px)); text-align:center; }
	.world-choice button { width:100%; min-height:52px; padding:14px 24px; border:1px solid #697174; background:#090b0dcc; color:#d4d7d7; letter-spacing:.2em; cursor:pointer; }
	.world-choice button:hover { background:#191d20; border-color:#b6bdbd; }
	.world-choice button:disabled { cursor:wait; opacity:.5; }
	.world-choice p { margin-top:12px; color:#b4bcbc; font-size:13px; line-height:1.7; }
	.world-dialogue { position:absolute; bottom:max(24px,env(safe-area-inset-bottom)); left:50%; transform:translateX(-50%); width:min(1000px,calc(100vw - 32px)); min-height:165px; padding:18px 26px 26px; border:1px solid #596166; background:#0a0e12e8; box-shadow:inset 0 0 0 3px #000; }
	.world-dialogue header { display:flex; justify-content:space-between; align-items:center; gap:1rem; letter-spacing:.12em; font-size:13px; } .world-dialogue header div { display:flex; align-items:center; gap:14px; } .world-dialogue small { font:10px monospace; color:#7e898f; }
	.world-auto { display:grid; place-items:center; width:44px; height:44px; color:#7d898f; border:1px solid transparent; background:transparent; }
	.world-auto[aria-pressed="true"] { color:#e3e6e8; border-color:#69767d; background:#18212a; }
	.world-words { font-size:clamp(15px,1.7vw,20px); line-height:1.9; margin-top:16px; } .world-caret { position:absolute; right:22px; bottom:12px; color:#78868d; }
	.world-return { position:absolute; top:24px; right:24px; padding:10px 18px; border:1px solid #4e585e; background:#080b0ecc; color:#b3b9bd; font-size:13px; }
	.world-screen :focus-visible { outline:2px solid #a1b0bb; outline-offset:4px; }
	.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
	@media(max-width:480px) { .world-dialogue { padding:12px 18px 24px; min-height:170px; } .world-return { top:16px; right:16px; } }
</style>
