---
import AboutNoticeboard from "@/components/layout/AboutNoticeboard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

const description = "认识绫：图书馆的馆员，可以说是被站长直接拉过来干活的，不过干的相当起劲呢";
---

<MainGridLayout title="绫" description={description}>
	<AboutNoticeboard label="绫" number="03">
		<div class="about-ling-layout">
			<figure class="ling-portrait-stage notice-paper pinned">
				<img
					src={url("/images/oc-pet/ling-portrait-anime-v4.webp")}
					alt="绫的全身立绘：黑色齐肩直发、白色衬衫、黑色长裙与皮鞋，双手在胸前指尖相触，微笑着说话"
					width="1024"
					height="1536"
					decoding="async"
				/>
				<figcaption>CHARACTER PORTRAIT · LING</figcaption>
			</figure>

			<div class="about-ling-notes">
				<header class="ling-heading notice-paper taped">
					<p class="notice-overline">LIBRARY GUIDE · CHARACTER FILE 01</p>
					<h1>绫 <span>Ling</span></h1>
					<p>图书馆里最尽职的馆员，年度十佳馆员（虽然也没有其他馆员了捏）</p>
				</header>

				<div class="ling-details notice-paper taped">
					<p class="notice-overline">馆藏人物 / 01</p>
					<h2>欢迎来到这座私人图书馆</h2>
					<p>最佳图书馆员（站长认证）</p>
					<dl>
						<div><dt>姓名</dt><dd>绫 / Ling</dd></div>
						<div><dt>外形</dt><dd>黑色齐肩直发，黑棕色眼睛</dd></div>
						<div><dt>服装</dt><dd>白色衬衫、黑色长裙与黑色皮鞋</dd></div>
						<div><dt>身份</dt><dd>说了是最佳馆员呢</dd></div>
					</dl>
				</div>

				<div class="ling-pet-note notice-paper taped">
					<img src={url("/images/oc-pet/idle.webp")} alt="绫的 Q 版桌宠形象" width="1254" height="1254" loading="lazy" decoding="async" />
					<p>左下角的 Q 版绫会陪你逛网站。点击可以和她互动，也可以拖动或收起她。</p>
				</div>
			</div>
		</div>
	</AboutNoticeboard>
</MainGridLayout>
