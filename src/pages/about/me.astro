---
import { Icon } from "astro-icon/components";
import AboutNoticeboard from "@/components/layout/AboutNoticeboard.astro";
import { homeIntroConfig, profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAuthorAvatarUrl } from "@/utils/schema-image";
import { buildProfilePage } from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

const avatarUrl = await getAuthorAvatarUrl();
const jsonLd = buildProfilePage({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: Astro.url.toString(),
	avatarUrl,
	description: profileConfig.bio,
});
---

<MainGridLayout title="本人" description={profileConfig.bio}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<AboutNoticeboard label="本人" number="01">
		<div class="about-person-file">
			<figure class="about-photo notice-paper pinned">
				<img
					src={url(profileConfig.avatar || "/avatar.svg")}
					alt={profileConfig.name}
					width="320"
					height="320"
					decoding="async"
				/>
				<figcaption>PERSONAL FILE / 01</figcaption>
			</figure>
			<div class="about-profile-note notice-paper taped">
				<p class="notice-overline">关于我</p>
				<h1>{profileConfig.name}</h1>
				{
					profileConfig.bio && (
						<p>
							{profileConfig.bio}
						</p>
					)
				}
			</div>
		</div>

		<div class="about-social">
			<h2>社交链接</h2>
			<div class="about-link-slips">
				{
					homeIntroConfig.links.map((link) => (
						<a
							href={link.url}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							class="about-link-slip notice-paper taped"
						>
							<Icon name={link.icon} aria-hidden="true" />
							<span>{link.name}</span>
						</a>
					))
				}
			</div>
		</div>
	</AboutNoticeboard>
</MainGridLayout>
