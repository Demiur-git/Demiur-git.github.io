---
import { Icon } from "astro-icon/components";
import { homeIntroConfig, profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAuthorAvatarUrl } from "@/utils/schema-image";
import { buildProfilePage } from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

const avatarUrl = await getAuthorAvatarUrl();
const jsonLd = buildProfilePage({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: Astro.url.toString(),
	avatarUrl,
	description: profileConfig.bio,
});
---

<MainGridLayout title="本人" description={profileConfig.bio}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<section class="card-base p-7 sm:p-10">
		<div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
			<img
				src={url(profileConfig.avatar || "/avatar.svg")}
				alt={profileConfig.name}
				class="h-24 w-24 shrink-0 rounded-full border border-(--line-divider) bg-white object-cover sm:h-28 sm:w-28"
				width="112"
				height="112"
			/>
			<div class="min-w-0">
				<p class="text-sm font-medium text-(--primary)">关于我</p>
				<h2 class="mt-2 text-3xl font-bold text-90">{profileConfig.name}</h2>
				{
					profileConfig.bio && (
						<p class="mt-3 max-w-2xl text-sm leading-7 text-50 sm:text-base">
							{profileConfig.bio}
						</p>
					)
				}
			</div>
		</div>

		<div class="mt-8 border-t border-(--line-divider) pt-7">
			<h3 class="text-sm font-semibold text-75">社交链接</h3>
			<div class="mt-4 flex flex-wrap gap-3">
				{
					homeIntroConfig.links.map((link) => (
						<a
							href={link.url}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							class="btn-plain flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium text-75 hover:text-(--primary)"
						>
							<Icon name={link.icon} aria-hidden="true" />
							<span>{link.name}</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</MainGridLayout>
