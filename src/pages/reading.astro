---
import { Icon } from "astro-icon/components";
import { readingPlanConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";

const statusLabel = {
	planned: "准备阅读",
	reading: "正在阅读",
	finished: "已经读完",
};
---

<MainGridLayout title={readingPlanConfig.title} description={readingPlanConfig.description}>
	<section class="page-shell collection-page collection-reading">
		<header class="card-base page-header collection-masthead">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:menu-book-outline-rounded" />
				</div>
				<div>
					<span class="collection-kicker">READING LEDGER · 07</span>
					<h2>{readingPlanConfig.title}</h2>
					<p>{readingPlanConfig.description}</p>
				</div>
			</div>
			<div class="page-count" aria-label="书目数量">
				<Icon name="material-symbols:menu-book-outline-rounded" />
				<strong>{readingPlanConfig.books.length}</strong>
				<span>本</span>
			</div>
		</header>

		{
			readingPlanConfig.books.length > 0 ? (
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					{readingPlanConfig.books.map((book) => (
						<article class="card-base reading-slip p-6">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h3 class="text-lg font-bold text-90">{book.title}</h3>
									{book.author && <p class="mt-1 text-sm text-50">{book.author}</p>}
								</div>
								<span class="rounded-full bg-(--btn-plain-bg-hover) px-3 py-1 text-xs text-(--primary)">
									{statusLabel[book.status]}
								</span>
							</div>
							{book.note && <p class="mt-4 text-sm leading-6 text-50">{book.note}</p>}
						</article>
					))}
				</div>
			) : (
				<div class="card-base collection-empty flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
					<Icon name="material-symbols:menu-book-outline-rounded" class="mb-4 text-6xl opacity-50" />
					<p class="text-lg">还没有添加读书计划</p>
				</div>
			)
		}
	</section>
</MainGridLayout>
