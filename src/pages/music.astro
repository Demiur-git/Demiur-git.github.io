---
import MusicCollection from "@/components/pages/music/MusicCollection.svelte";
import PulseClue from "@/components/features/PulseClue.astro";
import { musicPlayerConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = musicPlayerConfig.page?.title ?? "音乐馆藏";
const description =
	musicPlayerConfig.page?.description ??
	"在唱片与歌词之间，收藏想要反复聆听的声音。";
---

<MainGridLayout title={title} description={description}>
	<div class="collection-page collection-music">
		<PulseClue clue="music" />
		<MusicCollection client:load title={title} description={description} />
	</div>
</MainGridLayout>
<style>.collection-music { position:relative; }</style>
