---
import { getEntry, render } from "astro:content";
import Comment from "@/components/comment/index.astro";
import Markdown from "@/components/common/Markdown.astro";
import AboutNoticeboard from "@/components/layout/AboutNoticeboard.astro";
import { commentConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/guestbook.css";

if (!siteConfig.pages.guestbook) return Astro.redirect("/404/");
const guestbookPost = await getEntry("spec", "guestbook");
if (!guestbookPost) throw new Error("guestbook page content not found");
const { Content } = await render(guestbookPost);
const isCommentEnabled = commentConfig.type !== "none" &&
	(commentConfig.type !== "waline" || Boolean(commentConfig.waline?.serverURL));
---

<MainGridLayout title="留言板" description="在图书馆留下一张纸笺，分享想法、阅读感受与建议。">
	<div class="guestbook-board">
		<AboutNoticeboard label="访客留言" number="09" indexLabel="VISITORS">
			<header class="guestbook-intro notice-paper taped">
				<p class="notice-overline">NOTES FROM VISITORS</p>
				<h1>留言板</h1>
				<Markdown class="guestbook-intro-copy"><Content /></Markdown>
			</header>
			{isCommentEnabled ? (
				<Comment post={guestbookPost} customPath="/guestbook/" variant="guestbook" />
			) : (
				<section class="guestbook-unavailable notice-paper" aria-label="留言服务状态">
					<h2>留言暂未开放</h2>
					<p>留言服务尚未配置，开放后即可在这里交流。</p>
				</section>
			)}
		</AboutNoticeboard>
	</div>
</MainGridLayout>
