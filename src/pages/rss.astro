---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getSubscriptionEntries } from "@/utils/subscription-content";
import { url } from "@/utils/url-utils";
import "@/styles/pages/subscription.css";

const site = Astro.site ?? new URL(siteConfig.site_url);
const feeds = [
	{ number: "01", title: "书库文章", path: "/rss.xml", scope: "ARTICLES", description: "收藏完整的思考与实践，只接收书库文章。", note: "适合慢慢阅读的长篇内容。" },
	{ number: "02", title: "便签", path: "/feeds/memos.xml", scope: "MEMOS", description: "馆长的短想法、过程记录与日常片段。", note: "当前便签为空；有新便签后会随发布更新。" },
	{ number: "03", title: "文章＋便签", path: "/feeds/all.xml", scope: "COLLECTION", description: "合并两类内容，用一份订阅关注馆藏的新入库。", note: "不包含留言、音乐、相册、项目或代码提交。" },
];
const entries = await getSubscriptionEntries({ site, kind: "all", includeContent: false });
const recentEntries = entries.slice(0, 6);
const hasMemos = entries.some((entry) => entry.kind === "memo");
const atomAddress = new URL(url("/atom.xml"), site).href;
---

<MainGridLayout title="馆藏订阅处" description="领取一张订阅卡，让新文章与便签抵达你的阅读器。">
	<section class="subscription-desk" aria-labelledby="subscription-title">
		<header class="subscription-notice subscription-paper">
			<div class="subscription-register"><span>PALIB · CIRCULATION DESK</span><span>馆藏通知 / RSS</span></div>
			<div class="subscription-notice-body">
				<div>
					<p class="subscription-eyebrow">一份送往阅读器的更新通知</p>
					<h1 id="subscription-title">馆藏订阅处</h1>
					<p class="subscription-lead">不必时时回来查看。领取一张订阅卡，<br class="subscription-desktop-break" />让新文章与便签，在你的阅读器里相遇。</p>
				</div>
				<div class="subscription-postmark" aria-hidden="true"><span>PALIB</span><strong>新入馆藏</strong><span>READ AT YOUR PACE</span></div>
			</div>
			<p class="subscription-notice-foot">无需账号，也无需留下邮箱。订阅由你的阅读器检查；这里不会发送邮件或浏览器通知。</p>
		</header>

		<subscription-copy class="subscription-cards" aria-label="选择订阅内容">
			{feeds.map((feed) => {
				const address = new URL(url(feed.path), site).href;
				return <article class="subscription-card subscription-paper">
					<div class="subscription-card-index"><span>订阅登记卡</span><span>NO. {feed.number}</span></div>
					<p class="subscription-eyebrow">{feed.scope}</p>
					<h2>{feed.title}</h2>
					<p class="subscription-card-description">{feed.description}</p>
					<div class="subscription-address"><span>订阅地址</span><code>{address}</code></div>
					<div class="subscription-card-actions">
						<button type="button" data-subscription-copy={address} aria-label={`复制${feed.title}订阅地址`}>复制地址</button>
						<a href={url(feed.path)} target="_blank" rel="noopener noreferrer" data-no-swup>打开订阅源 <span aria-hidden="true">↗</span></a>
					</div>
					<p class="subscription-copy-status" role="status" aria-live="polite" data-copy-status></p>
					<p class="subscription-card-note">{feed.number === "02" && hasMemos ? "短篇记录与生活片段，按发布日期送达。" : feed.note}</p>
				</article>;
			})}
		</subscription-copy>

		<section class="subscription-guide subscription-paper" aria-labelledby="subscription-guide-title">
			<div class="subscription-guide-heading"><span aria-hidden="true">↳</span><h2 id="subscription-guide-title">如何领取更新</h2></div>
			<ol><li><span>01</span>复制喜欢的订阅地址</li><li><span>02</span>在阅读器中添加订阅源</li><li><span>03</span>由阅读器定期检查更新</li></ol>
			<p>内容会在网站重新发布后更新。旧文章修订不会变成重复的新条目，是否提醒修订取决于阅读器。</p>
			<details><summary>我使用 Atom 格式的阅读器</summary><p>书库文章也提供 Atom 格式，复制下面的地址即可；原有订阅继续有效。</p><code>{atomAddress}</code><a href={url("/atom.xml")} target="_blank" rel="noopener noreferrer" data-no-swup>打开 Atom 订阅源 ↗</a></details>
		</section>

		<section class="subscription-bulletin subscription-paper" aria-labelledby="subscription-bulletin-title">
			<header><div><span class="subscription-eyebrow">THE LIBRARY BULLETIN</span><h2 id="subscription-bulletin-title">最近入藏</h2></div><span class="subscription-edition">文章与便签 · 最近六条</span></header>
			{recentEntries.length ? <ol class="subscription-news">
				{recentEntries.map((entry) => <li><article>
					<div class="subscription-news-meta"><span>{entry.kind === "post" ? "书库文章" : "便签"}</span><time datetime={entry.published.toISOString()}>{formatDateToYYYYMMDD(entry.published)}</time></div>
					<h3><a href={entry.link}>{entry.title}</a></h3>
					{entry.description && <p>{entry.description}</p>}
				</article></li>)}
			</ol> : <p class="subscription-empty">馆藏尚未入库。有新文章或便签时，这里会出现最新记录。</p>}
			<footer><span>只收录文章与便签</span><a href={url("/library/")}>前往书库 <span aria-hidden="true">→</span></a></footer>
		</section>
	</section>
</MainGridLayout>

<script>
	import { registerSubscriptionCopy } from "@/utils/subscription-copy";
	registerSubscriptionCopy();
</script>
