---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import LibraryHeader from "@/components/layout/LibraryHeader.astro";
import LibraryStats from "@/components/controls/LibraryStats.astro";
import PulseClue from "@/components/features/PulseClue.astro";
import { getSortedPostsList } from "@/utils/content-utils";
const dates = (await getSortedPostsList()).filter((p) => !p.data.draft).map((p) => p.data.published.toISOString());
---

<MainGridLayout title={i18n(I18nKey.archive)}>
  <section class="collection-page collection-articles" aria-label="书库归档">
    <LibraryHeader title="归档" description="沿着年份与月份，慢慢翻阅收藏的文字。" code="02" />
    <LibraryStats dates={dates} />
    <div class="archive-clue-margin"><PulseClue clue="categories" /><ArchivePanel /></div>
  </section>
</MainGridLayout>
<style>.archive-clue-margin { position:relative; padding-top:2.5rem; } .archive-clue-margin :global(pulse-clue) { left:4px; right:auto; }</style>
