---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title={i18n(I18nKey.archive)}>
  <section class="collection-page collection-articles" aria-labelledby="archive-page-title">
    <header class="card-base collection-masthead collection-simple-header">
      <div>
        <span class="collection-kicker">WRITTEN ARCHIVE · 02</span>
        <h1 id="archive-page-title">{i18n(I18nKey.archive)}</h1>
        <p>按年份整理，慢慢翻阅收藏的文字。</p>
      </div>
      <span class="collection-index" aria-hidden="true">02</span>
    </header>
    <ArchivePanel />
  </section>
</MainGridLayout>
