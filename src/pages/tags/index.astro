---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LibraryHeader from "@/components/layout/LibraryHeader.astro";
import TagGraph from "@/components/controls/TagGraph.astro";
import { getSortedPostsList } from "@/utils/content-utils";
import { buildTagGraph } from "@/utils/library-data";
const graph = buildTagGraph(await getSortedPostsList());
---
<MainGridLayout title="标签图谱" description="沿着标签之间的联系，发现书库里的阅读线索。">
	<LibraryHeader title="标签图谱" description="分类是主标签；展开一个分类，沿着小标签寻找阅读线索。" code="04" />
	<TagGraph graph={graph} />
</MainGridLayout>
