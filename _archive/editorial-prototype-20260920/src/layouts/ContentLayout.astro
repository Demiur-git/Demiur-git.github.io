---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/date';

interface Props {
	kind: 'note' | 'article'; title: string; description: string; pubDate: Date;
	updatedDate?: Date; tags: string[]; number?: number; readingTime?: string;
}
const { kind, title, description, pubDate, updatedDate, tags, number, readingTime } = Astro.props;
const isNote = kind === 'note';
const backHref = isNote ? '/notes' : '/articles';
const backLabel = isNote ? '全部笔记' : '全部文章';
---

<BaseLayout title={title} description={description}>
	<article class="content-page shell">
		<a class="back-link" href={backHref}>← {backLabel}</a>
		<header class="content-header">
			<div class="content-kicker">
				<span>{isNote ? `NOTE ${String(number).padStart(3, '0')}` : 'LONGFORM ESSAY'}</span>
				<span>{formatDate(pubDate)}</span>
			</div>
			<h1>{title}</h1>
			<p class="content-deck">{description}</p>
			<div class="content-byline">
				<span>撰写 / {formatDate(pubDate)}</span>
				{readingTime && <span>阅读 / {readingTime}</span>}
				{updatedDate && <span>修订 / {formatDate(updatedDate)}</span>}
			</div>
		</header>
		<div class="content-rule"><span></span><i></i></div>
		<div class="prose"><slot /></div>
		<footer class="content-footer">
			<div class="tag-list" aria-label="标签">{tags.map((tag) => <span>#{tag}</span>)}</div>
			<a href={backHref}>继续阅读 →</a>
		</footer>
	</article>
</BaseLayout>
