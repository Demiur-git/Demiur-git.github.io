---
import { SITE_EDITION, SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const navItems = [
	{ href: '/', label: '主页', index: '01' },
	{ href: '/notes', label: '笔记', index: '02' },
	{ href: '/articles', label: '文章', index: '03' },
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header shell">
	<div class="utility-bar">
		<span>PERSONAL EDITION</span>
		<span>{SITE_EDITION}</span>
		<span class="utility-status"><i></i> AVAILABLE ONLINE</span>
	</div>
	<div class="masthead">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE}主页`}>
			<span>{SITE_TITLE}</span>
			<small>NOTES & ESSAYS</small>
		</a>
		<nav aria-label="主导航">
			<ul>
				{navItems.map((item) => (
					<li><a class:list={{ active: isActive(item.href) }} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><sup>{item.index}</sup>{item.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>
